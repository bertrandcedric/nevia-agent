# Copy to .env (ignored by git). agent.sh reads its settings from here only: the shell's
# variables and arguments don't override them.

# Nevia workspace (ID or exact name)
NEVIA_WORKSPACE=default
# Fine-grained token limited to the repo: Contents + Pull requests (read/write); read by `agent.sh setup` only
GITHUB_TOKEN=
# GitHub repo (owner/name) cloned by `agent.sh migrate`
REPO=

# Optional, defaults shown
#BASE_BRANCH=main
#CLAUDE_MODEL=
#CLAUDE_MAX_TURNS=150
#APP_COMPUTER=hello-app
#MIGRATION_DIR=migration/<name of REPO>
#AGENT=hello-agent
#KEY_TTL=30d
