# Copy to .env (ignored by git): the secrets both agents need. `agent` reads it at each command; a variable
# already set in the shell wins. `agent m2p setup` and `agent acc setup` copy them into workspace secrets
# (acc's named with its prefix, e.g. ACC_GITHUB_TOKEN); nothing else here leaves this machine.

# --- Both agents ---------------------------------------------------------------------------------------

# The Aiven AI gateway key: m2p's Copilot and acc's Claude Code go through the gateway with it
# (m2p.copilot.gateway_secret and acc.claude.gateway_secret in agent.toml name this variable).
AIVEN_AI_API_KEY=

# Nevia: without these, `nevia login` on this machine. A token, or a key file of a principal.
#NEVIA_TOKEN=
#NEVIA_KEY_FILE=

# --- acc -----------------------------------------------------------------------------------------------

# A GitHub fine-grained token on acc.repo.github only: Contents and Pull requests, read and write.
GITHUB_TOKEN=

# --- Optional ------------------------------------------------------------------------------------------

# Another settings file than agent.toml, e.g. to run under separate resource names.
#AGENT_CONFIG=
