# Copy to .env (ignored by git). Loaded by agent.sh; a variable already set in the shell wins
# over this file.

# Nevia workspace (ID or exact name)
NEVIA_WORKSPACE=default

# Fine-grained token limited to the repo(s) the agent works on: Contents + Pull requests (read/write).
# Copied into the workspace secret GITHUB_TOKEN on each run.
GITHUB_TOKEN=

# Optional
# REPO=owner/name          # repo cloned by `run` unless --repo (else: the origin of the git repo you
                           # run from, else bertrandcedric/nevia-helloworld)
# BASE_BRANCH=main
# CLAUDE_MODEL=claude-sonnet-5-5
# AGENT=hello-agent
# KEY_TTL=30d              # lifetime of the agent's Nevia key (agent.sh setup)

# The application the agent works on, in the cloned repo (same for any repo you pick)
# APP_DIR=.                # folder with deploy.sh and pom.xml (. for the repo root)
# APP_COMPUTER=hello-app   # its computer, checkpointed for each run
# APP_DATABASE=hello-pg    # its database, branched for each run
