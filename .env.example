# Copy to agent/.env (ignored by git): the one config of uc1 (rc-lab.sh), uc2 (agent.sh) and uc3
# (lab.sh). They read their settings from it only: the shell's variables don't override them.
# A plain KEY is for every use case; UC1_KEY, UC2_KEY, UC3_KEY for that one only, and it wins
# (uc1 and uc3 both have PG_NAME, CLAUDE_MAX_TURNS...: prefix them).

# --- Every use case ------------------------------------------------------------------------------

# Nevia workspace (ID or exact name)
NEVIA_WORKSPACE=default

# The one Nevia computer of uc1, uc2 and uc3, and its Nevia key (a principal of the same name,
# editor): made by the first setup of any use case, managed by ./computer.sh (rotate-key, status,
# sleep, destroy). Two agents may run on it at once: setup never renews the key; rotate-key does,
# and refuses while a run is going.
#AGENT=nevia-agent
#AGENT_KEY_TTL=30d             how long a new key works (15m to 90d)

# Claude Code: log in once on each computer (nevia shell <computer>, claude, /login), or one of
# these, stored as a workspace secret by each setup: a token from `claude setup-token` or an API key
# (uc1, uc3)
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=
# Or through a gateway (e.g. Aiven's AI gateway): its URL and token (the token stored as a
# workspace secret by setup, run it again after changing it; the URL and the models go with each run)
#ANTHROPIC_BASE_URL=https://<the gateway's URL>
#ANTHROPIC_AUTH_TOKEN=
#ANTHROPIC_MODEL=                the model's name at the gateway (CLAUDE_MODEL, if set, wins)
#ANTHROPIC_DEFAULT_OPUS_MODEL=   the gateway's names for Claude Code's opus, sonnet, haiku aliases
#ANTHROPIC_DEFAULT_SONNET_MODEL=
#ANTHROPIC_DEFAULT_HAIKU_MODEL=
#CLAUDE_MODEL=                   uc1, uc3: claude-opus-5-5 by default

# --- uc1: a MongoDB (Rocket.Chat by default) to Nevia Postgres, rc-lab.sh -----------------------

# SOURCE: a folder of uc1/sources/ that sets the MongoDB up on the computer (up, seed) and
# describes it to Claude; its source.env gives the defaults of what follows. Empty: an existing one.
#UC1_SOURCE=rocketchat
# As the computer reaches it (credentials included: it stays on the computer, never in the prompt)
#UC1_MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
#UC1_MONGO_DB=rocketchat
#UC1_PG_NAME=rc-pg              the Postgres database; its branches are rc-pg-try<N>
#UC1_LAB_HTTPS_PORT=            the computer's port Nevia publishes on 443 (Rocket.Chat: 3000; the
#                               computer is shared: uc2 and uc3 publish none)
#UC1_CLAUDE_MAX_TURNS=250
#UC1_CLAUDE_BASH_MAX_OUTPUT=10000   characters of a command's output Claude keeps (the rest is
#                                   cut): every token kept is paid again at each later turn
# Rocket.Chat data (uc1/sources/rocketchat/seed.mjs)
#UC1_SEED_USERS=40
#UC1_SEED_CHANNELS=10
#UC1_SEED_GROUPS=4
#UC1_SEED_DMS=20
#UC1_SEED_MESSAGES=3000
#UC1_SEED=42

# --- uc2: the app's code from MongoDB to Postgres, as a pull request, agent.sh ------------------

# Fine-grained token limited to the repo: Contents + Pull requests (read/write); read by setup only
#UC2_GITHUB_TOKEN=
# GitHub repo (owner/name) cloned by `agent.sh migrate`
#UC2_REPO=
#UC2_BASE_BRANCH=main
#UC2_CLAUDE_MAX_TURNS=150
# Tools Claude may use without asking (the whole list; default in uc2/agent-bootstrap.sh)
#UC2_CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash(mvn:*),Bash(java:*),Bash(curl:*),Bash(psql:*)
# Claude Code's effort: low, medium, high, xhigh, max (default: Claude Code's)
UC2_CLAUDE_EFFORT=medium
#UC2_APP_COMPUTER=hello-app
#UC2_MIGRATION_DIR=migration/<name of REPO>

# --- uc3: nevia-helloworld's MongoDB to Nevia Postgres, lab.sh ----------------------------------

#UC3_COMPUTER=uc3-agent         uc3's own computer (not AGENT: uc3 does not share it), its principal
#                               and its key (secret UC3_NEVIA_KEY), renewed by ./lab.sh rotate-key
#UC3_PG_NAME=uc3-m2p            the Postgres database; its branches are uc3-m2p-try<N>
#UC3_SLEEP_AT_END=yes           the computer to sleep at the end of migrate
# The customers of ./lab.sh seed (uc3/remote/seed/seed.mjs): how many, and the seed of their values
#UC3_SEED_CUSTOMERS=5000
#UC3_SEED=42
# The percent of them that are strange (one to three anomalies each), and which anomalies: all, or
# some of phone-number, quantity-string, quantity-long, quantity-negative, price-string,
# price-decimal128, date-string, date-epoch, null-fields, empty-strings, missing-required,
# enum-case, unknown-fields, long-text, unicode, object-not-array, scalar-not-array, mixed-array,
# nested-deeper, empty-object, bool-string, id-objectid, duplicate-order-id, odd-field-names
#UC3_SEED_STRANGE=5
#UC3_SEED_STRANGE_KINDS=all
#UC3_CLAUDE_MAX_TURNS=250
#UC3_CLAUDE_BASH_MAX_OUTPUT=10000
