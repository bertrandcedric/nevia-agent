# Copy to .env (ignored by git). rc-lab.sh reads its settings from here only: the shell's
# variables don't override them.

# Nevia workspace (ID or exact name)
NEVIA_WORKSPACE=default

# The MongoDB to migrate, one database per run.
# SOURCE: a folder of sources/ that sets it up on the computer (up, seed) and describes it to
# Claude; its source.env gives the defaults of what follows. Empty: an existing MongoDB.
#SOURCE=rocketchat
# As the computer reaches it (credentials included: it stays on the computer, never in the prompt)
#MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
#MONGO_DB=rocketchat

# Optional, defaults shown
#LAB=rc-lab                 the computer: the source (if any), mongo2pg, Claude Code
#PG_NAME=rc-pg              the Postgres database; its branches are rc-pg-try<N>
#KEY_TTL=7d                 the computer's Nevia key (for nvpg), renewed by ./rc-lab.sh setup
#LAB_HTTPS_PORT=            the computer's port Nevia publishes on 443 (Rocket.Chat: 3000)
# Claude Code: log in once on the computer (nevia shell rc-lab, claude, /login), or one of these
# (stored as a workspace secret by setup): a token from `claude setup-token`, or an API key
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=
#CLAUDE_MODEL=claude-opus-5-5    claude-sonnet-5-5 or claude-haiku-5-5 for cheaper runs
#CLAUDE_MAX_TURNS=250
#CLAUDE_BASH_MAX_OUTPUT=10000   characters of a command's output Claude keeps (the rest is cut):
#                               every token kept is paid again at each later turn
# Rocket.Chat data (sources/rocketchat/seed.mjs)
#SEED_USERS=40
#SEED_CHANNELS=10
#SEED_GROUPS=4
#SEED_DMS=20
#SEED_MESSAGES=3000
#SEED=42
