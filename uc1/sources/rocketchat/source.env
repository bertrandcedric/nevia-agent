# The defaults of this source, read by rc-lab.sh after .env (which wins).
# The MongoDB to migrate, as the lab computer reaches it, and the database.
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB=rocketchat
# The computer's port Nevia publishes on 443 (setup): Rocket.Chat's.
LAB_HTTPS_PORT=3000
