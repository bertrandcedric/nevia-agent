#!/bin/sh
# Claude's only way to Nevia: the lab's Postgres ($PG_NAME) and its branches <PG_NAME>-<name>.
#   nvpg ls                  the database and its branches
#   nvpg branch              new branch try<N> (next number) of the database, its schema empty;
#                            prints its name and the mongo2pg import command that loads it
#   nvpg uri [<name>]        URI of a branch (or of the database, once nvpg import main ran), for
#                            a script: never print it
#   nvpg config [<name>]     (re)write the mongo2pg config that targets it; prints its path
#   nvpg import [<name>|main] mongo2pg import of the project into a clean schema of a branch (the
#                            newest without a name), once per branch: an attempt imports once. The
#                            main database: only after a branch passed node verify.mjs since its
#                            last import, and only this way (run.sh refuses mongo2pg import on
#                            its configs). A branch may also take mongo2pg import -c <its config>.
#   nvpg psql [<name>] [ARG]…  psql on a branch (or the database), ON_ERROR_STOP on, e.g.
#                            nvpg psql try2 -c 'select 1', nvpg psql try2 -f fixes.sql;
#                            read only on a failed attempt, and on the database until
#                            nvpg import main
#   nvpg state               each target: imported, failed (and why) or passed
# One attempt, one branch: a branch whose import failed, or that node verify.mjs failed on since
# its import, is closed (read only). The way on is a new branch, never the same one fixed. A branch
# is never promoted: once one passes, the migration is imported again into the database. No rm:
# the branch of each failed attempt stays, as it failed, until the next run starts clean.
set -eu
die() { echo "nvpg: $*" >&2; exit 1; }
. "$HOME/uc3/lab.env"
# The key file of the run that started Claude (setup/env.sh): deleted when that run ends.
[ -n "${NEVIA_KEY_FILE:-}" ] && [ -s "$NEVIA_KEY_FILE" ] || die "no Nevia key file (NEVIA_KEY_FILE): nvpg runs inside a migrate run"
export NEVIA_WORKSPACE NEVIA_KEY_FILE
PATH=$HOME/.local/bin:$PATH
# --non-interactive where the CLI has it (the one on a Nevia computer doesn't, and never prompts).
NV_NI=; ! nevia --non-interactive --help >/dev/null 2>&1 || NV_NI=--non-interactive
# --yes after the subcommand, where it has the flag (see lib.sh's nv).
nv() {
  if [ "$1" = --yes ]; then shift; ! nevia "$@" --help 2>/dev/null | grep -q -- '--yes' || set -- "$@" --yes; fi
  nevia $NV_NI "$@"
}

target() {
  case ${1:-} in
    ''|main) echo "$PG_NAME" ;;
    *[!a-z0-9-]*|-*) die "a branch name is lowercase letters, digits and dashes, got '$1'" ;;
    *) [ ${#1} -le 30 ] || die "branch name too long"; echo "$PG_NAME-$1" ;;
  esac
}

# config <db>: a copy of the project config, its target the URI of <db>.
config() {
  dir=$(dirname "$CONFIG")/branches; mkdir -p "$dir"
  f=$dir/$1.toml
  uri=$(nv pg connect --uri "$1")
  (umask 077 && awk -v uri="$uri" '
    /^\[/ { sect = $0 }
    sect == "[target]" && /^uri[ \t]*=/ { print "uri = \"" uri "\""; next }
    { print }' "$CONFIG" > "$f")
  echo "$f"
}

# next_try: the number after the highest try<N> branch (a run starts with none: try1).
next_try() {
  nv --json pg ls | jq -r --arg p "$PG_NAME-try" '
    [.. | objects | select(has("name")) | .name | select(startswith($p)) | ltrimstr($p) | tonumber? ] |
    (max // 0) + 1'
}

# The state of each attempt, in $ATTEMPTS (cleared at the start of a run): <db>.imported (when),
# <db>.closed (why). Its verification is verify.mjs's own result, verify-<name>.json in $WORK.
mkdir -p "$ATTEMPTS"
short() { case $1 in "$PG_NAME") echo main ;; *) echo "${1#"$PG_NAME"-}" ;; esac; }
# A branch imported with mongo2pg import itself has no <db>.imported: its verification counts as is.
verdict() {  # verdict <db>: pass, fail or none, from verify.mjs's run since the import
  v=$WORK/verify-$(short "$1").json
  [ -s "$v" ] && { [ ! -e "$ATTEMPTS/$1.imported" ] || [ "$v" -nt "$ATTEMPTS/$1.imported" ]; } || { echo none; return; }
  if jq -e '.fail == 0 and .pass > 0' "$v" >/dev/null 2>&1; then echo pass; else echo fail; fi
}
closed() {  # closed <db>: why, if it is
  if [ -s "$ATTEMPTS/$1.closed" ]; then cat "$ATTEMPTS/$1.closed"
  elif [ "$(verdict "$1")" = fail ]; then echo "node verify.mjs $(short "$1") failed"; fi
}
newest() {
  nv --json pg ls | jq -r --arg p "$PG_NAME-try" '
    [.. | objects | select(has("name")) | .name | select(startswith($p)) | ltrimstr($p) | tonumber? ] |
    if length == 0 then empty else "\(max)" end'
}

case ${1:-} in
  ls) nv pg ls | awk -v p="$PG_NAME" 'NR == 1 || $2 == p || index($2, p "-") == 1' ;;
  branch)
    [ -z "${2:-}" ] || die "usage: nvpg branch (it names the branch itself)"
    db=$PG_NAME-try$(next_try)
    nv --yes pg branch "$PG_NAME" -b "$db" --wait >/dev/null
    # Empty: a branch made once the main database is loaded has its tables, and mongo2pg import
    # refuses a schema that exists (run 261027181323, try7).
    uri=$(nv pg connect --uri "$db")
    psql "$uri" -X -q -v ON_ERROR_STOP=1 -c "DROP SCHEMA IF EXISTS \"$SCHEMA\" CASCADE" >/dev/null ||
      die "could not empty the schema $SCHEMA of $(short "$db")"
    unset uri
    echo "branch $db (nvpg psql try${db##*-try}, ...)"
    echo "next, now: mongo2pg import -c $(config "$db") --log-level error" ;;
  # Not the main database's before nvpg import main: a script would write to it outside an attempt.
  uri)
    db=$(target "${2:-}")
    [ "$db" != "$PG_NAME" ] || [ -e "$ATTEMPTS/$db.imported" ] ||
      die "no URI of main until nvpg import main (once a branch has passed): an attempt is on a branch, nvpg branch"
    nv pg connect --uri "$db" ;;
  config) config "$(target "${2:-}")" ;;
  # psql without the URI on the command line: Claude Code refuses "$(nvpg uri)".
  import)
    [ $# -le 2 ] || die "usage: nvpg import [try<N> | main] (its config, --log-level error: nvpg passes them)"
    if [ -n "${2:-}" ]; then name=$2; else n=$(newest); [ -n "$n" ] || die "no branch yet: nvpg branch"; name=try$n; fi
    db=$(target "$name")
    if [ "$db" = "$PG_NAME" ]; then
      ok=
      for f in "$WORK"/verify-try*.json; do
        [ -s "$f" ] || continue
        b=$PG_NAME-$(basename "$f" .json | sed 's/^verify-//')
        [ "$(verdict "$b")" = pass ] || continue
        [ ! -e "$ATTEMPTS/$db.imported" ] || [ "$f" -nt "$ATTEMPTS/$db.imported" ] || continue
        ok=$b
      done
      [ -n "$ok" ] || die "the main database takes the migration once a branch has passed node verify.mjs$([ -e "$ATTEMPTS/$db.imported" ] && echo " since its last import"): make an attempt on a new branch (nvpg branch)"
      echo "nvpg: importing into the main database, as $(short "$ok") passed"
      rm -f "$ATTEMPTS/$db.closed"
    else
      [ ! -e "$ATTEMPTS/$db.imported" ] ||
        die "$name was imported already: an attempt imports once. Fix the project (mapping, DDL), regenerate, then a new branch: nvpg branch"
    fi
    date +%s > "$ATTEMPTS/$db.imported"
    # A clean schema: a branch holds the main database's data of when it was made.
    uri=$(nv pg connect --uri "$db")
    psql "$uri" -X -q -v ON_ERROR_STOP=1 -c "DROP SCHEMA IF EXISTS \"$SCHEMA\" CASCADE" >/dev/null ||
      die "could not empty the schema $SCHEMA of $(short "$db")"
    unset uri
    if mongo2pg import -c "$(config "$db")" --log-level error; then
      echo "nvpg: imported into $(short "$db"); next, on it: fix-data.sql, your SQL fixes, node verify.mjs $(short "$db")"
    else
      echo "import failed" > "$ATTEMPTS/$db.closed"
      die "the import into $(short "$db") failed: this attempt is over (read only). Fix the cause in the project, regenerate, then nvpg branch"
    fi ;;
  # The targets imported by nvpg import, and those verified (imported with mongo2pg import).
  state)
    dbs=$( { for f in "$ATTEMPTS"/*.imported; do [ -e "$f" ] && basename "$f" .imported; done
             for f in "$WORK"/verify-*.json; do [ -e "$f" ] && target "$(basename "$f" .json | sed 's/^verify-//')"; done
           } | sort -u)
    [ -n "$dbs" ] || echo "no import yet"
    for db in $dbs; do
      why=$(closed "$db")
      if [ -n "$why" ]; then echo "$(short "$db"): failed ($why), read only"
      else echo "$(short "$db"): imported, $(verdict "$db" | sed 's/none/not verified yet/; s/pass/verify.mjs passed/')"; fi
    done ;;
  # psql without the URI on the command line: Claude Code refuses "$(nvpg uri)".
  psql)
    shift; name=
    case ${1:-} in ''|-*) ;; *) name=$1; shift ;; esac
    db=$(target "$name") why=$(closed "$(target "$name")")
    if [ -n "$why" ]; then
      echo "nvpg: $(short "$db") is a failed attempt ($why): read only. The way on: fix the project, then nvpg branch" >&2
      PGOPTIONS="-c default_transaction_read_only=on" exec psql "$(nv pg connect --uri "$db")" -v ON_ERROR_STOP=1 "$@"
    fi
    # The main database is written only after nvpg import main: an attempt is on a branch.
    if [ "$db" = "$PG_NAME" ] && [ ! -e "$ATTEMPTS/$db.imported" ]; then
      echo "nvpg: main is read only until nvpg import main (once a branch has passed): an attempt is on a branch, nvpg branch" >&2
      PGOPTIONS="-c default_transaction_read_only=on" exec psql "$(nv pg connect --uri "$db")" -v ON_ERROR_STOP=1 "$@"
    fi
    exec psql "$(nv pg connect --uri "$db")" -v ON_ERROR_STOP=1 "$@" ;;
  -h|--help|help) sed -n '2,/^set -eu/ { /^set -eu/d; s/^# \{0,1\}//p; }' "$0" ;;
  *) sed -n '2,/^set -eu/ { /^set -eu/d; s/^# \{0,1\}//p; }' "$0" >&2; exit 1 ;;
esac
